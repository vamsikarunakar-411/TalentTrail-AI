# AI Interview Chatbot Server Environment Configuration
PORT=5000

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
# If left blank or invalid, the backend automatically switches to [SIMULATION MODE]
# with explicit labels so you can test all features without an API key.
GEMINI_API_KEY=

# Configurable Gemini Model Name
# Supported options: gemini-3.5-flash, gemini-3.8-flash, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.5-flash

# Maximum PDF resume upload size in bytes (default 5MB)
MAX_FILE_SIZE_BYTES=5242880
